# Copy to .streamlit/secrets.toml (local) or paste into Streamlit Cloud's
# "Secrets" box (deployed). Never commit the real file - it's gitignored.

# ---- Sign-in (required) -------------------------------------------------
# Google OAuth client - see DEPLOYMENT.md step 2.
[auth]
redirect_uri = "http://localhost:8501/oauth2callback"   # deployed: https://<your-app>.streamlit.app/oauth2callback
cookie_secret = "paste a long random string here"      # python -c "import secrets; print(secrets.token_hex(32))"
client_id = "xxxxxxxx.apps.googleusercontent.com"
client_secret = "GOCSPX-xxxxxxxx"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# ---- Database (required when deployed) ----------------------------------
# Leave out locally to use climber_profiles/harnesssync.db.
# [database]
# url = "postgresql://user:password@host/dbname?sslmode=require"

# ---- Feedback email (optional) ------------------------------------------
# [email]
# address = "you@gmail.com"
# app_password = "xxxx xxxx xxxx xxxx"
# to_address = "you@gmail.com"

# ---- Local development without sign-in (never enable when deployed) -----
# [app]
# dev_mode = true
